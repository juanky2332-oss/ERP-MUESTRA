# ── Copia este archivo a .env.local y rellena los valores reales ──────────────
# .env.local nunca se sube a git (está en .gitignore).

# Supabase — Settings > API en tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# OpenAI — usado por el asistente ARIA, el OCR de gastos y la transcripción de voz
OPENAI_API_KEY=tu_openai_api_key
# Modelo para el OCR de facturas/gastos (opcional, por defecto gpt-4o)
# OPENAI_MODEL_OCR=gpt-4o

# Gmail — envío de presupuestos/facturas por correo (ver INSTRUCCIONES_EMAIL.md)
GMAIL_USER=tu-correo@gmail.com
GMAIL_PASS=tu_contraseña_de_aplicacion_de_16_caracteres

# Identidad de la empresa que usa este ERP (se puede cambiar sin tocar código)
NEXT_PUBLIC_COMPANY_NAME=EMPRESA X, S.L.
NEXT_PUBLIC_COMPANY_NIF=B00000000
NEXT_PUBLIC_COMPANY_EMAIL=administracion@empresax-demo.com

# Panel de soporte interno (opcional, deja vacío si no lo usas)
# NEXT_PUBLIC_SOPORTE_URL=
# NEXT_PUBLIC_SOPORTE_TOKEN=
